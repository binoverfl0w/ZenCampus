# Kotlin style for ZenCampus: four-space indents and lines that fit a side-by-side diff.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 140
ij_kotlin_imports_layout = *
ij_kotlin_allow_trailing_comma = true
