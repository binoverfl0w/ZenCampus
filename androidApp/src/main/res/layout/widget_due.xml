<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="7dp" android:layout_height="7dp" android:src="@drawable/widget_dot_alert" android:importantForAccessibility="no" />
        <TextView android:id="@+id/due_label" style="@style/WidgetLabel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Due soon · 3 open" />
    </LinearLayout>
    <TextView android:id="@+id/due_empty" style="@style/WidgetDetail" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:maxLines="2" android:visibility="gone" android:text="Nothing due this week" />
    <LinearLayout android:id="@+id/due_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:orientation="vertical">
        <LinearLayout android:id="@+id/due_row_0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/due_avatar_0" style="@style/WidgetAvatar" android:background="@drawable/widget_avatar_soft_alert" android:textColor="@color/widget_alert" android:text="AD" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView android:id="@+id/due_title_0" style="@style/WidgetTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Exercises Sheet 05" />
                <TextView android:id="@+id/due_course_0" style="@style/WidgetDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Algorithms &amp; Data Engineering" />
            </LinearLayout>
            <TextView android:id="@+id/due_when_0" style="@style/WidgetChip" android:layout_marginStart="8dp" android:background="@drawable/widget_chip_alert" android:textColor="@color/widget_alert" android:text="Tomorrow 10:00" />
        </LinearLayout>
        <LinearLayout android:id="@+id/due_row_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/due_avatar_1" style="@style/WidgetAvatar" android:background="@drawable/widget_avatar_soft_study" android:textColor="@color/widget_study" android:text="ER" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView android:id="@+id/due_title_1" style="@style/WidgetTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Exercises Sheet 06" />
                <TextView android:id="@+id/due_course_1" style="@style/WidgetDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Embedded Robotics" />
            </LinearLayout>
            <TextView android:id="@+id/due_when_1" style="@style/WidgetChip" android:layout_marginStart="8dp" android:background="@drawable/widget_chip_study" android:textColor="@color/widget_study" android:text="Thu 26 Nov · 10:00" />
        </LinearLayout>
        <LinearLayout android:id="@+id/due_row_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/due_avatar_2" style="@style/WidgetAvatar" android:background="@drawable/widget_avatar_soft_study" android:textColor="@color/widget_study" android:text="OS" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView android:id="@+id/due_title_2" style="@style/WidgetTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Project report" />
                <TextView android:id="@+id/due_course_2" style="@style/WidgetDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Operating Systems" />
            </LinearLayout>
            <TextView android:id="@+id/due_when_2" style="@style/WidgetChip" android:layout_marginStart="8dp" android:background="@drawable/widget_chip_study" android:textColor="@color/widget_study" android:text="Fri 27 Nov · 23:59" />
        </LinearLayout>
        <LinearLayout android:id="@+id/due_row_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/due_avatar_3" style="@style/WidgetAvatar" android:background="@drawable/widget_avatar_soft_study" android:textColor="@color/widget_study" android:text="" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView android:id="@+id/due_title_3" style="@style/WidgetTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" />
                <TextView android:id="@+id/due_course_3" style="@style/WidgetDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" />
            </LinearLayout>
            <TextView android:id="@+id/due_when_3" style="@style/WidgetChip" android:layout_marginStart="8dp" android:background="@drawable/widget_chip_study" android:textColor="@color/widget_study" android:text="" />
        </LinearLayout>
        <LinearLayout android:id="@+id/due_row_4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <TextView android:id="@+id/due_avatar_4" style="@style/WidgetAvatar" android:background="@drawable/widget_avatar_soft_study" android:textColor="@color/widget_study" android:text="" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:orientation="vertical">
                <TextView android:id="@+id/due_title_4" style="@style/WidgetTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" />
                <TextView android:id="@+id/due_course_4" style="@style/WidgetDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" />
            </LinearLayout>
            <TextView android:id="@+id/due_when_4" style="@style/WidgetChip" android:layout_marginStart="8dp" android:background="@drawable/widget_chip_study" android:textColor="@color/widget_study" android:text="" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
