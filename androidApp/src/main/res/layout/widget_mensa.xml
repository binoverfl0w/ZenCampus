<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_card_mensa">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="7dp" android:layout_height="7dp" android:src="@drawable/widget_dot_mensa" android:importantForAccessibility="no" />
        <TextView android:id="@+id/mensa_label" style="@style/WidgetLabel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Mensa today" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
        <LinearLayout android:id="@+id/meal_row_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <ImageView android:id="@+id/meal_line_0" android:layout_width="match_parent" android:layout_height="1dp" android:src="@drawable/widget_divider" android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="gone" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="3dp">
                <ImageView android:id="@+id/meal_diet_0" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="6dp" android:src="@drawable/widget_dot_library" android:contentDescription="Vegan" android:visibility="gone" />
                <TextView android:id="@+id/meal_name_0" style="@style/WidgetDetail" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/widget_text" android:textSize="12sp" android:text="★ Organic Mie noodles" />
                <TextView android:id="@+id/meal_price_0" style="@style/WidgetTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="12sp" android:text="2,90 €" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/meal_row_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <ImageView android:id="@+id/meal_line_1" android:layout_width="match_parent" android:layout_height="1dp" android:src="@drawable/widget_divider" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="3dp">
                <ImageView android:id="@+id/meal_diet_1" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="6dp" android:src="@drawable/widget_dot_library" android:contentDescription="Vegan" />
                <TextView android:id="@+id/meal_name_1" style="@style/WidgetDetail" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/widget_text" android:textSize="12sp" android:text="Lentil curry" />
                <TextView android:id="@+id/meal_price_1" style="@style/WidgetTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="12sp" android:text="3,20 €" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/meal_row_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <ImageView android:id="@+id/meal_line_2" android:layout_width="match_parent" android:layout_height="1dp" android:src="@drawable/widget_divider" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="3dp">
                <ImageView android:id="@+id/meal_diet_2" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="6dp" android:src="@drawable/widget_dot_library" android:contentDescription="Vegan" android:visibility="gone" />
                <TextView android:id="@+id/meal_name_2" style="@style/WidgetDetail" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/widget_text" android:textSize="12sp" android:text="Schnitzel" />
                <TextView android:id="@+id/meal_price_2" style="@style/WidgetTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="12sp" android:text="4,10 €" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/meal_row_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <ImageView android:id="@+id/meal_line_3" android:layout_width="match_parent" android:layout_height="1dp" android:src="@drawable/widget_divider" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="3dp">
                <ImageView android:id="@+id/meal_diet_3" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="6dp" android:src="@drawable/widget_dot_library" android:contentDescription="Vegan" />
                <TextView android:id="@+id/meal_name_3" style="@style/WidgetDetail" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/widget_text" android:textSize="12sp" android:text="Country potatoes" />
                <TextView android:id="@+id/meal_price_3" style="@style/WidgetTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="12sp" android:text="1,30 €" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/meal_row_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <ImageView android:id="@+id/meal_line_4" android:layout_width="match_parent" android:layout_height="1dp" android:src="@drawable/widget_divider" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="3dp">
                <ImageView android:id="@+id/meal_diet_4" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="6dp" android:src="@drawable/widget_dot_library" android:contentDescription="Vegan" android:visibility="gone" />
                <TextView android:id="@+id/meal_name_4" style="@style/WidgetDetail" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/widget_text" android:textSize="12sp" android:text="Rice" />
                <TextView android:id="@+id/meal_price_4" style="@style/WidgetTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="12sp" android:text="1,20 €" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/meal_row_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <ImageView android:id="@+id/meal_line_5" android:layout_width="match_parent" android:layout_height="1dp" android:src="@drawable/widget_divider" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingVertical="3dp">
                <ImageView android:id="@+id/meal_diet_5" android:layout_width="6dp" android:layout_height="6dp" android:layout_marginEnd="6dp" android:src="@drawable/widget_dot_library" android:contentDescription="Vegan" />
                <TextView android:id="@+id/meal_name_5" style="@style/WidgetDetail" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/widget_text" android:textSize="12sp" android:text="Salad" />
                <TextView android:id="@+id/meal_price_5" style="@style/WidgetTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="12sp" android:text="1,50 €" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/mensa_status" style="@style/WidgetTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" android:text="Closed today" />
    <TextView android:id="@+id/mensa_more" style="@style/WidgetDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="+3 more" />
</LinearLayout>
