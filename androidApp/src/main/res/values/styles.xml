<resources>
    <style name="Theme.ZenCampus" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#516A7A</item>
        <item name="android:windowBackground">#F5F4F0</item>
    </style>
    <!-- MainActivity's launch window on Android 8-11; Android 12+ draws its system splash instead. -->
    <style name="Theme.ZenCampus.Launch" parent="Theme.ZenCampus">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
