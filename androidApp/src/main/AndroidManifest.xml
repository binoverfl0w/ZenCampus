<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Installs a verified update from the app's GitHub release; the system still asks the student to confirm. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:name=".ZenApplication"
        android:label="ZenCampus"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.ZenCampus">
        <activity android:name=".MainActivity" android:exported="true" android:theme="@style/Theme.ZenCampus.Launch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Hand in a file from another app: the student picks a submission folder and reviews before upload. -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
        <receiver android:name=".HomeWidgetProvider" android:exported="false" android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_day_info" />
        </receiver>
        <receiver android:name=".NextClassWidget" android:exported="false" android:label="@string/widget_next_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_next_info" />
        </receiver>
        <receiver android:name=".MensaWidget" android:exported="false" android:label="@string/widget_mensa_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_mensa_info" />
        </receiver>
        <receiver android:name=".DueSoonWidget" android:exported="false" android:label="@string/widget_due_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_due_info" />
        </receiver>
        <receiver android:name=".LibraryWidget" android:exported="false" android:label="@string/widget_library_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_library_info" />
        </receiver>
        <activity android:name=".LoginActivity" android:exported="false" />
        <activity android:name=".LibraryLoginActivity" android:exported="false" />
        <activity android:name=".DocumentActivity" android:exported="false" />
        <activity android:name=".CampusPageActivity" android:exported="false" />
        <activity android:name=".SaveMaterialActivity" android:exported="false" />
        <receiver android:name=".UpdateInstallReceiver" android:exported="false" />
        <provider
            android:name=".MaterialFileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
